# Example environment variables - NO real secrets

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bookstore
DB_USER=root
DB_PASSWORD=REPLACE_ME
DB_DIALECT=mysql
DATABASE_URL=mysql://root:REPLACE_ME@127.0.0.1:3306/bookstore

# Optional test database overrides
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=bookstore_test
TEST_DB_USER=root
TEST_DB_PASSWORD=REPLACE_ME
TEST_DATABASE_URL=mysql://root:REPLACE_ME@127.0.0.1:3306/bookstore_test

# Optional production URL (example key used by config/config.json)
JAWSDB_URL=mysql://user:password@host:3306/database

GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_API_KEY=REPLACE_ME
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
FIREBASE_APP_ID=REPLACE_ME
