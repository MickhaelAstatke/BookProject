# Example environment variables - NO real secrets

GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_API_KEY=REPLACE_ME
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
FIREBASE_APP_ID=REPLACE_ME

# Optional local-only DB sync overrides (do not enable in shared environments)
# DB_SYNC_ALTER=true
# DB_SYNC_FORCE=true
