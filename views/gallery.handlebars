<div class="row container">
  {{#if materials.length}}
    {{#each materials}}
      <div class="col s12 m6 l4">
        <div class="card hoverable">
          {{#if thumbnailUrl}}
            <div class="card-image">
              <img class="responsive-img" src="{{thumbnailUrl}}" alt="{{title}} thumbnail" />
            </div>
          {{/if}}
          <div class="card-content">
            <span class="card-title">{{title}}</span>
            <p class="grey-text text-darken-1">{{authorName}}</p>
            <p class="grey-text">{{typeLabel}}</p>
          </div>
          <div class="card-action">
            <a href="{{assetUrl}}" target="_blank" rel="noopener noreferrer">View material</a>
          </div>
        </div>
      </div>
    {{/each}}
  {{else}}
    <div class="col s12">
      <p class="center-align">No materials available yet. Please check back later.</p>
    </div>
  {{/if}}
</div>
